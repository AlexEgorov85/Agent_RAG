# =============================================================
# Конфигурация окружения (пример). Скопируйте в .env и заполните.
# =============================================================

# --- LLM / VLM: Cloud.ru Foundation Models (GigaChat, OpenAI-совместимый API) ---
LLM_API_KEY=ВСТАВИТЬ ВАШ КЛЮЧ
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_MODEL=GigaChat/GigaChat-3-Pro
# VLM для описания графиков (если используется отдельная vision-модель)
VLM_MODEL=GigaChat/GigaChat-3-Pro

# --- Эмбеддинги: курсовой Giga-Embeddings через Cloud.ru (Занятие 3) ---
EMBED_MODEL=ai-sage/Giga-Embeddings-instruct-3B
# Префикс по умолчанию — курсовой Instruct/Query (src/core/rag_config.py).
# EMBED_QUERY_PREFIX=query:

# --- Reranker: курсовой LLM-реранкер (Занятие 5), НЕ CrossEncoder ---
RERANKER_MODEL=ai-sage/GigaChat3-10B-A1.8B
# 1 — включён (по умолчанию), 0 — отключить для latency/cost-экспериментов
RERANK_ENABLED=1

# --- Бюджет контекста ---
# Полное окно модели в токенах; под чанки остаётся window - output - reserve.
CONTEXT_WINDOW_TOKENS=32768
OUTPUT_TOKENS=2048
CONTEXT_RESERVE_TOKENS=2048
# Дополнительный жёсткий предел в символах (страховка от раздувания промпта).
CONTEXT_CHARS=16000
# Максимум кандидатов retrieval; упаковка сама решит, сколько чанков влезет.
TOP_K=5

# --- Пути ---
DATA_RAW=data/raw
DATA_PROCESSED=data/processed
STORAGE_DIR=storage
