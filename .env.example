# =============================================================
# Конфигурация окружения (пример). Скопируйте в .env и заполните.
# =============================================================

# --- LLM / VLM: Cloud.ru Foundation Models (GigaChat, OpenAI-совместимый API) ---
LLM_API_KEY=ВСТАВИТЬ ВАШ КЛЮЧ
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_MODEL=GigaChat/GigaChat-3-Pro
# VLM для описания графиков (если используется отдельная vision-модель)
VLM_MODEL=GigaChat/GigaChat-3-Pro

# --- Эмбеддинги: курсовой Giga-Embeddings через Cloud.ru (Занятие 3) ---
EMBED_MODEL=ai-sage/Giga-Embeddings-instruct-3B
# Префикс по умолчанию — курсовой Instruct/Query (src/core/rag_config.py).
# EMBED_QUERY_PREFIX=query:

# --- Reranker: курсовой LLM-реранкер (Занятие 5), НЕ CrossEncoder ---
RERANKER_MODEL=ai-sage/GigaChat3-10B-A1.8B
# 1 — включён (по умолчанию), 0 — отключить для latency/cost-экспериментов
RERANK_ENABLED=1
# Модель router/rewrite/structure; пусто — использовать LLM_MODEL.
# ROUTER_MODEL=

# --- Бюджеты и лимиты агента (src/core/rag_config.py, RAGSettings) ---
# Все значения имеют безопасные defaults; env нужен только для override.
# Жёсткий потолок вызовов инструментов и поисков на один запрос.
# MAX_TOOL_CALLS=4
# MAX_SEARCH_CALLS=2
# Лимиты TemporalSearch: top-k на год и максимум рассматриваемых лет.
# PER_YEAR_K=2
# MAX_YEARS=12
# Максимум документов/лет структурного анализа за прогон.
# MAX_STRUCTURE_DOCS=5
# Формулировки одного поиска и мягкое разнообразие выдачи.
# MAX_QUERIES=3
# DIVERSITY_ENABLED=1
# MAX_PER_DOC=2
# MAX_PER_SECTION=1
# Coverage-добивка пропусков и проверка ответа.
# COVERAGE_ENABLED=1
# MAX_COVERAGE_SEARCHES=1
# VERIFICATION_ENABLED=1

# --- Межпроцессный LLM-lock (chat / evaluation / CLI benchmark) ---
# LLM_LOCK_PATH=data/evaluation/llm.lock
# LLM_LOCK_TIMEOUT_S=900
# LLM_LOCK_STALE_S=900
# LLM-подсистемы: 1 — включены (default), 0 — детерминированный fallback без сети.
# LLM_ROUTER_ENABLED=1
# LLM_REWRITE_ENABLED=1
# LLM_STRUCTURE_VERIFY=1

# --- Бюджет контекста ---
# Полное окно модели в токенах; под чанки остаётся window - output - reserve.
CONTEXT_WINDOW_TOKENS=32768
OUTPUT_TOKENS=2048
CONTEXT_RESERVE_TOKENS=2048
# Дополнительный жёсткий предел в символах (страховка от раздувания промпта).
CONTEXT_CHARS=16000
# Максимум кандидатов retrieval; упаковка сама решит, сколько чанков влезет.
TOP_K=5

# --- Пути ---
DATA_RAW=data/raw
DATA_PROCESSED=data/processed
STORAGE_DIR=storage
# Корпус для чата/API/Streamlit: по умолчанию dev из 4 документов.
# Для канонических 2015–2018: CHUNKS_DIR=data/chunks, CACHE_DIR=data/cache.
CHUNKS_DIR=data/dev/chunks
CACHE_DIR=data/dev/cache

# --- PDF parser (src/core/config.py, ParserSettings) ---
# PARSE_STRATEGY=hi_res
# PARSE_PAGE_BATCH=20
# PARSE_MIN_IMAGE_AREA=40000
# STORE_IMAGE_PAYLOAD=1
# OCR_LANGUAGES=["rus","eng"]
# TESSDATA_PREFIX=tessdata
# DATA_ELEMENTS_DIR=data/elements
# DATA_STRUCTURE_DIR=data/structure
# DATA_CHUNKS_DIR=data/chunks
# DATA_FIGURES_DIR=data/figures

# --- Постоянный FAISS-индекс эмбеддингов ---
# 1 — использовать faiss-cpu; 0 — in-memory DenseIndex.
# FAISS_ENABLED=1
# FAISS_PERSIST=1
# INDEXES_DIR=data/indexes
# Реестр источников: issuer/country чанков и изоляция несопоставимых отчётов.
# SOURCE_REGISTRY_PATH=data/source_registry.json

# --- HTTP API adapter (src/api/README.md) ---
# Режим владельца: local — один пользователь, cookie HttpOnly.
AUTH_MODE=local
# API_DB_PATH=var/api.sqlite3
# API_SOURCE_REGISTRY_PATH=data/source_registry.json
# API_CORPUS_NAME=Локальный корпус
# API_OWNER_COOKIE=rag_owner
# API_COOKIE_SECURE=0
# API_SESSION_MAX_AGE=31536000
# CORS dev-сервера Vite; production работает same-origin.
# API_CORS_ORIGINS=http://localhost:5173
# Раздача собранного SPA из FastAPI (same-origin; по умолчанию выключено).
# API_SERVE_SPA=0
# API_SPA_DIST_DIR=frontend/dist
# API_RATE_LIMIT_PER_MINUTE=120
# API_MAX_MESSAGE_CHARS=16000
# API_MAX_EVENT_BYTES=262144
# API_MAX_EVIDENCE_BYTES=1048576
# API_REPLAY_BUFFER_EVENTS=1000
# API_REPLAY_TTL_SECONDS=600
# API_HEARTBEAT_SECONDS=15
# API_PAGE_SIZE_DEFAULT=50
# API_PAGE_SIZE_MAX=200
# API_HISTORY_RETENTION_DAYS=0

# --- Evaluation / Benchmark WebUI (docs/specs/evaluation-webui.md) ---
# Раздел выключен по умолчанию: при 0 endpoints отвечают 404 evaluation_disabled,
# а capabilities.evaluation_ui=false.
EVAL_UI_ENABLED=0
# EVAL_RESULTS_DIR=eval/results
# EVAL_DATASETS_DIR=eval/datasets
# EVAL_DB_PATH=data/evaluation/evaluation.sqlite3
# EVAL_MAX_CONCURRENCY=1
# EVAL_QUEUE_SIZE=3
# EVAL_RETENTION_RUNS=50
# EVAL_YIELD_MS=250
# EVAL_TURN_TIMEOUT_S=300
# EVAL_RUN_TIMEOUT_S=7200
# EVAL_JUDGE_ENABLED=0
# 1 — офлайн-запуск без LLM/сети (артефакты помечаются fake_service)
# EVAL_FAKE_SERVICE=0
